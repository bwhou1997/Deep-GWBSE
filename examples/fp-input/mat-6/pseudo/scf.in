&CONTROL
  calculation = 'scf'
  outdir = './out/'
  prefix = 'MOSE2_WS2'
  pseudo_dir = './pseudo/'
/
&SYSTEM
  ecutwfc = 100.0
  ibrav = 4
  a = 3.322
  c = 30
  nat = 3
  ntyp = 2
  noncolin=.true.
  lspinorb=.true.
/
&ELECTRONS
  electron_maxstep = 100
  conv_thr = 1e-10
  mixing_mode = 'plain'
  mixing_beta = 0.7
  mixing_ndim = 8
  diagonalization = 'david'
  diago_david_ndim = 4
  diago_full_acc = .true.
/

ATOMIC_SPECIES
Mo     95.96 Mo_PBE_FR.ABIv0.4.UPF
Se     78.96 Se_PBE_FR.ABIv0.4.UPF
ATOMIC_POSITIONS crystal
Mo           -0.0000000000       -0.0000000000        0.7166666666
Se            0.6666666667        0.3333333333        0.7723045408
Se            0.6666666667        0.3333333333        0.6610285390
K_POINTS automatic
24 24 1 0 0 0
